// SPDX-License-Identifier: MIT
//
// Common DT fragment for both halves of Thenar v1.
//
// Switch topology (per half, switch-per-pin, no diodes):
//
//   MCP_A bank (16 switches): num row (6) + top row (6) + first 4 of home row
//   MCP_B bank (16 switches): rest of home (2) + bottom row (6) + mod (2)
//                             + thumbs (2) + scrollwheel button (1) + 3 spares
//
// Each switch is wired one-to-one to a single MCP23017 GPIO pin. Internal
// pull-ups are enabled via the kscan binding so each switch shorts the
// pin to GND when pressed.

#include <dt-bindings/zmk/matrix_transform.h>
#include "thenar_v1-layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
        zmk,kscan = &kscan_direct;
    };

    // Linear position numbering for the keymap. With switch-per-pin we
    // skip the matrix abstraction entirely - each kscan input maps to a
    // single keymap position. ZMK position numbers go left-to-right,
    // top-to-bottom across BOTH halves; on the right half the same
    // transform is reused but the shield's per-half overlay reorders the
    // input-gpios list so the wiring still lines up.
    default_transform: keymap_transform_0 {
        compatible = "zmk,kscan-transform";
        rows = <1>;
        columns = <56>;
        map = <
RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)            RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)  RC(0,10) RC(0,11)
RC(0,12) RC(0,13) RC(0,14) RC(0,15) RC(0,16) RC(0,17)           RC(0,18) RC(0,19) RC(0,20) RC(0,21) RC(0,22) RC(0,23)
RC(0,24) RC(0,25) RC(0,26) RC(0,27) RC(0,28) RC(0,29)           RC(0,30) RC(0,31) RC(0,32) RC(0,33) RC(0,34) RC(0,35)
RC(0,36) RC(0,37) RC(0,38) RC(0,39) RC(0,40) RC(0,41)           RC(0,42) RC(0,43) RC(0,44) RC(0,45) RC(0,46) RC(0,47)
                              RC(0,48) RC(0,49) RC(0,50) RC(0,51) RC(0,52) RC(0,53) RC(0,54) RC(0,55)
        >;
    };

    // EVQWGD001 scrollwheel-mounted encoder. Both halves can mount one;
    // shield overlay enables whichever side has it physically installed.
    encoder_left: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&mcp_b 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&mcp_b 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <30>;
        status = "disabled";
    };

    encoder_right: encoder_right {
        compatible = "alps,ec11";
        a-gpios = <&mcp_b 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&mcp_b 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <30>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_left &encoder_right>;
        triggers-per-rotation = <15>;
    };
};

// Single direct-mode kscan placeholder. The per-half overlay sets
// input-gpios to the actual list of 28 MCP23017 pin handles ordered by
// the keymap position those switches map to.
/ {
    kscan_direct: kscan_direct {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        debounce-press-ms = <5>;
        debounce-release-ms = <5>;
        // input-gpios is populated by thenar_v1_{left,right}.overlay.
    };
};
