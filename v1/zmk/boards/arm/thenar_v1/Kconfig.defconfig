# SPDX-License-Identifier: MIT

if BOARD_THENAR_V1

config BOARD
    default "thenar_v1"

config ZMK_BLE
    default y

config ZMK_USB
    default y

# Bluetooth-only is a battery saver - USB transport stays available
# for keymap flashing but the radio is the primary path.
config BT_CTLR
    default y

config BT_LL_SW_SPLIT
    default y

endif # BOARD_THENAR_V1
