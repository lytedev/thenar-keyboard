#include <physical_layouts.dtsi>

// Physical key positions for ZMK Studio's keymap visualizer. Coordinates
// are in centiunits (100 = 1u). TODO: these were ported from the upstream
// corax-layouts.dtsi and adjusted by adding two outer-column "num row"
// positions (one per half) to match thenar's 4-key outer column. Verify
// against the actual PCB outline (thenar/ergogen/config.yaml) and refine
// once the keyboard is built and visualized.
//
// Positions enumerated in the order the keymap reads them: visually
// left-to-right, top-to-bottom, scanning both halves at each row.

/ {
    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Thenar";

        kscan = <&kscan0>;
        transform = <&default_transform>;

        keys
            //                            w   h    x    y     rot    rx    ry
            // Num row (12 keys, outer column included on each half)
            = <&key_physical_attrs 100 100  200    0       0     0     0>
            , <&key_physical_attrs 100 100  306   33       0     0     0>
            , <&key_physical_attrs 100 100  406    0       0     0     0>
            , <&key_physical_attrs 100 100  506   33       0     0     0>
            , <&key_physical_attrs 100 100  606   48       0     0     0>
            , <&key_physical_attrs 100 100  706   48       0     0     0>
            , <&key_physical_attrs 100 100 1008   48       0     0     0>
            , <&key_physical_attrs 100 100 1108   48       0     0     0>
            , <&key_physical_attrs 100 100 1208   33       0     0     0>
            , <&key_physical_attrs 100 100 1308    0       0     0     0>
            , <&key_physical_attrs 100 100 1408   33       0     0     0>
            , <&key_physical_attrs 100 100 1514    0       0     0     0>
            // Top row (12 keys)
            , <&key_physical_attrs 100 100  200  100       0     0     0>
            , <&key_physical_attrs 100 100  306  133       0     0     0>
            , <&key_physical_attrs 100 100  406  100       0     0     0>
            , <&key_physical_attrs 100 100  506  133       0     0     0>
            , <&key_physical_attrs 100 100  606  148       0     0     0>
            , <&key_physical_attrs 100 100  706  148       0     0     0>
            , <&key_physical_attrs 100 100 1008  148       0     0     0>
            , <&key_physical_attrs 100 100 1108  148       0     0     0>
            , <&key_physical_attrs 100 100 1208  133       0     0     0>
            , <&key_physical_attrs 100 100 1308  100       0     0     0>
            , <&key_physical_attrs 100 100 1408  133       0     0     0>
            , <&key_physical_attrs 100 100 1514  100       0     0     0>
            // Home row (12 keys)
            , <&key_physical_attrs 100 100  200  200       0     0     0>
            , <&key_physical_attrs 100 100  306  233       0     0     0>
            , <&key_physical_attrs 100 100  406  200       0     0     0>
            , <&key_physical_attrs 100 100  506  233       0     0     0>
            , <&key_physical_attrs 100 100  606  248       0     0     0>
            , <&key_physical_attrs 100 100  706  248       0     0     0>
            , <&key_physical_attrs 100 100 1008  248       0     0     0>
            , <&key_physical_attrs 100 100 1108  248       0     0     0>
            , <&key_physical_attrs 100 100 1208  233       0     0     0>
            , <&key_physical_attrs 100 100 1308  200       0     0     0>
            , <&key_physical_attrs 100 100 1408  233       0     0     0>
            , <&key_physical_attrs 100 100 1514  200       0     0     0>
            // Bottom row (12 keys)
            , <&key_physical_attrs 100 100  200  300       0     0     0>
            , <&key_physical_attrs 100 100  306  333       0     0     0>
            , <&key_physical_attrs 100 100  406  300       0     0     0>
            , <&key_physical_attrs 100 100  506  333       0     0     0>
            , <&key_physical_attrs 100 100  606  348       0     0     0>
            , <&key_physical_attrs 100 100  706  348       0     0     0>
            , <&key_physical_attrs 100 100 1008  348       0     0     0>
            , <&key_physical_attrs 100 100 1108  348       0     0     0>
            , <&key_physical_attrs 100 100 1208  333       0     0     0>
            , <&key_physical_attrs 100 100 1308  300       0     0     0>
            , <&key_physical_attrs 100 100 1408  333       0     0     0>
            , <&key_physical_attrs 100 100 1514  300       0     0     0>
            // Mod row + thumb cluster (6 keys total: 2 mod + 2 thumb each side
            // partitioned as left.middle, left.index, left.thumb_layer,
            // left.thumb_space, right.thumb_space mirror, right.thumb_layer mirror)
            // Only 2 mod keys per half (middle + index columns) and 2 thumb
            // keys per half - though thumbs are shared across both halves
            // physically; here we list 6 positions (2 mod left, 2 thumb pairs,
            // 2 mod right) to match the matrix transform's RC(4,3..8).
            , <&key_physical_attrs 100 100  506  433       0     0     0>
            , <&key_physical_attrs 100 100  606  448       0     0     0>
            , <&key_physical_attrs 150 100  712  520    1500   787   570>
            , <&key_physical_attrs 150 100 1027  520 (-1500)  1102   570>
            , <&key_physical_attrs 100 100 1108  448       0     0     0>
            , <&key_physical_attrs 100 100 1208  433       0     0     0>
            // Encoder push switches (left, right) - next to the inner
            // bottom corner where the scrollwheel mounts.
            , <&key_physical_attrs 100 100  810  348       0     0     0>
            , <&key_physical_attrs 100 100  905  348       0     0     0>
            ;
    };
};
