#include <dt-bindings/zmk/matrix_transform.h>
#include "thenar-layouts.dtsi"

/ {
    chosen {
        zmk,physical-layout = <&physical_layout0>;
        zmk,kscan = &kscan0;
    };

    // 5 rows x 12 cols. col-offset = 6 on the right-half overlay so left
    // half scans land in cols 0..5 and right half in cols 6..11.
    //
    // The mod row holds 8 keys total (4 per half): middle.mod, index.mod,
    // thumb.layer, thumb.space. Their matrix coords come from the ergogen
    // config:
    //
    //   middle.mod  : column_net=row1, row_net=col4 -> RC(4,1)
    //   index.mod   : column_net=row2, row_net=col4 -> RC(4,2)
    //   thumb.layer : column_net=row3, row_net=col4 -> RC(4,3)
    //   thumb.space : column_net=row4, row_net=col4 -> RC(4,4)
    //
    // Right half adds col-offset 6. Note its col-gpios are REVERSED
    // (inner-first, see thenar_right.overlay), so on that half matrix col
    // 6 is the INNERMOST finger column and col 11 the outermost:
    // right.thumb_space is RC(4,7) and right.middle_mod is RC(4,10).
    //
    // The mod row is listed ASCENDING on both halves so that keymap
    // positions read physical-left-to-right, exactly like the four grid
    // rows above (where position 6 = RC(0,6) = the right half's leftmost
    // key). The right half's four entries were descending until 2026-07,
    // which made positions 52-55 run right-to-left - the opposite
    // direction from every other row - so every thumb line in the keymap
    // was written mirrored while the rest of the layer was not. Behavior
    // is unchanged by the flip; the keymap's right-hand thumb groups were
    // reversed to compensate.
    //
    // The encoder's push switch is also in the matrix: column_net=row5,
    // row_net=col4 -> RC(4,5) on the left half, RC(4,11) on the right.
    // Both map to the last two keymap positions (56 = left press,
    // 57 = right press).
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <5>;
        columns = <12>;

        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                                 RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                                 RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)                                 RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)                                 RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
                                RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,7) RC(4,8) RC(4,9) RC(4,10)
RC(4,5) RC(4,6)
// ^ encoder presses: pos 56 = left (RC(4,5)), pos 57 = right (RC(4,6)).
// Both encoder push switches wire to the inner (row5) net. On the left
// half col-gpios are in normal order so inner = matrix col 5. On the
// right half col-gpios are REVERSED (inner-first, to mirror the main
// grid), so the inner net lands on matrix col 6 - NOT col 11. The
// right encoder press was RC(4,11) until 2026-07 and silently dropped
// (fired the unmapped RC(4,6)); the col-gpios reversal in the matrix
// fix moved it and this entry wasn't updated to match. Verified by
// USB-logging console capture.
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
    };

    // EVQWGD001 scrollwheel - mounts on whichever half is in use, with the
    // a/b pins wired identically to the corax. ZMK treats it as an encoder.
    encoder_left: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <30>;
        status = "disabled";
    };

    // Same pins as encoder_left: thenar routes the encoder to the ENCA/
    // ENCB nets (pins 20/21) on BOTH halves - the down-side jumpers next
    // to the encoder select the correct pin order per side. (The old 2/3
    // assignment was inherited from upstream corax and never applied to
    // thenar's routing.)
    encoder_right: encoder_right {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <30>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder_left &encoder_right>;
        // Measured on real hardware (evtest capture, 2026-07): the
        // EVQWGD001 has ~15 detents per revolution and emits 2 quadrature
        // pulses per detent, i.e. 30 pulses/rev - hence steps = <30> on
        // the encoder nodes and 15 triggers here for exactly one keymap
        // event per detent. Setting this to 30 double-fires per detent.
        triggers-per-rotation = <15>;
    };
};
